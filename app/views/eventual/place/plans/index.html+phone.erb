<div class="box">
  <h2><%= @place.name %></h2>
  <p class="size-7 text-grey"><%= @place.address %></p>
</div>

<%= render 'plan_ons' %>

<%= render layout: 'index_list' do %>
  <% @plans.group_by(&:event).each do |event, plans| %>
    <%= render partial: 'index_item', layout: 'index_item_actions', collection: plans, as: :model %>
  <% end %>
<% end %>
