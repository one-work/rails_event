<div class="box is-narrow">
  <h2><%= @place.name %></h2>
  <p class="size-7 text-grey">
    <%= svg_tag 'location-dot' %>
    <span><%= @place.address %></span>
  </p>
</div>

<div class="box">
  <%= @event.name %>
</div>

<%= render 'plan_ons' %>

<%= render layout: 'index_list' do %>
  <%= render partial: 'index_item', layout: 'index_item_actions', collection: @plans, as: :model %>
<% end %>
