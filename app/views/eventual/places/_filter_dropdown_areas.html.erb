<div data-controller="bulma-dropdown" class="dropdown is-left mt-3">
  <div class="dropdown-trigger">
    <button data-action="bulma-dropdown#appear" class="button">
      <span><%= @area.name %></span>
      <%= svg_tag 'angle-down' %>
    </button>
  </div>
  <div class="dropdown-menu">
    <div class="dropdown-content">
    <% @areas.each do |area| %>
      <%= link_to area.name, filter_params(area_id: area.id), class: active_helper(area_id: area.id, active: 'dropdown-item is-active', item: 'dropdown-item') %>
    <% end %>
    </div>
  </div>
</div>
