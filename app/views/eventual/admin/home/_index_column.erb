<div class="grid">
  <%= link_to({ controller: 'eventual/admin/time_lists' }, data: { turbo_frame: 'panel', action: 'menu-popup#enter' }, class: active_helper(controllers: ['time_lists'], item: 'cell button is-fullwidth', active: 'cell button is-fullwidth is-active')) do %>
    <span><%= t('eventual.admin.time_lists.index.title') %></span>
  <% end %>
  <%= link_to({ controller: 'eventual/admin/places' }, class: active_helper(controllers: ['places', 'place_taxons'], item: 'cell button is-fullwidth', active: 'cell button is-fullwidth is-active')) do %>
