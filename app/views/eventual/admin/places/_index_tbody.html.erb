<td><%= model.name %></td>
<td><%= model.area.full if model.area %></td>
<td><%= model.place_taxon&.name %></td>
<td>
  <%= link_to({ controller: 'halls', place_id: model.id }, aria: { label: t('.halls.index.title') }) do %>
    <%= svg_tag 'airplay' %>
    <span><%= model.halls_count %></span>
  <% end %>
</td>
<td>
  <%= link_to({ controller: 'seats', place_id: model.id }, aria: { label: t('.seats.index.title') }) do %>
    <%= svg_tag 'chair' %>
    <span><%= model.seats_count %></span>
  <% end %>
</td>
