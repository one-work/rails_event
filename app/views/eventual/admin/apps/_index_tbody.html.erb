<td><%= model.type_i18n %></td>
<td><%= model.name %></td>
<td><%= model.appid %></td>
<td><%= model.base_url %></td>
<td>
  <%= form_with theme: 'switch', model: model, scope: 'app', url: { action: 'update', id: model.id }, data: { controller: 'input' } do |f| %>
    <%= f.check_box :default, data: { action: 'input#submit' }, id: nil %>
  <% end %>
</td>