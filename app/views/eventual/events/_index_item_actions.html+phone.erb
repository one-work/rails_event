<div id="tr_<%= model.id %>" class="media">
  <div class="media-left">
    <figure class="image is-64x64">
      <%= image_tag model.logo.variant(resize_to_limit: [64, 64]) if model.logo.attached? %>
    </figure>
  </div>
  <%= link_to({ controller: 'plans', event_id: model.id }, class: 'media-content') do %>
    <%= yield %>
  <% end %>
  <div class="media-right">
    <%= link_to({ controller: 'plans', event_id: model.id }, class: 'button is-small is-rounded is-warning') do %>
      <span>购票</span>
    <% end %>
  </div>
</div>
