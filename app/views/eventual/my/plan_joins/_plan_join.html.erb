<%= form_with model: @order, url: { controller: 'trade/my/orders', action: 'create' }, data: { form_visible_value: 2 }, id: 'order_form', class: 'field is-grouped is-grouped-multiline p-3' do |f| %>
  <%= f.fields :items do |ef| %>
    <div class="control">
      <div class="tags has-addons is-medium">
        <%= ef.hidden_field :good_type %>
        <%= ef.hidden_field :good_id %>
        <%= ef.hidden_field :aim %>
        <%= ef.hidden_field :status, value: 'ordered' %>
        <div class="tag is-light">
          <span><%= ef.object.good.seat_no %></span>
        </div>
        <span data-id="<%= ef.object.good.seat_no %>" data-action="click->form#uncheck" class="tag is-delete"></span>
      </div>
      <% ef.object.good.wallet_price.slice(*@cart.wallet_codes).each do |code, price| %>
      <div class="tags has-addons">
        <span class="tag"><%= code %></span>
        <span class="text-danger"><%= ef.object.good.price.to_money.format.html_safe %></span>
      </div>
      <% end %>
    </div>
  <% end %>
<% end %>
