<div class="fixed-grid">
  <div class="grid width-max-content" style="--bulma-grid-column-count: <%= @events.length %>">
  <% @events.each do |plan| %>
    <%= link_to({ event_id: plan.event_id }, class: 'cell') do %>
      <div class="card" style="max-width: 128px;">
        <div class="card-image">
          <figure class="image">
            <%= image_tag plan.event.logo, loading: 'lazy' %>
          </figure>
        </div>
        <div class="card-content">
          <span class="size-7"><%= plan.event.name %></span>
        </div>
      </div>
    <% end %>
  <% end %>
  </div>
</div>
