<div class="overflow-x-scroll" style="min-height: 200px">
<div class="fixed-grid">
  <div class="grid width-max-content" style="--bulma-grid-column-count: <%= @events.length %>">
  <% @events.each do |plan| %>
    <%= link_to({ event_id: plan.event_id, **request.GET.slice(:plan_on) }, class: 'cell') do %>
      <div class="card">
        <div class="card-image">
          <figure class="image" style="height: 128px">
            <%= image_tag "#{plan.event.logo.url}!/fh/128", loading: 'lazy', style: 'height: 128px; object-fit: contain' %>
          </figure>
        </div>
        <div class="card-content text-centered p-2">
          <span class="size-7"><%= plan.event.name %></span>
        </div>
      </div>
    <% end %>
  <% end %>
  </div>
</div>
</div>