<div class="level overflow-x-scroll">
  <div class="level-left flex-direction-row overflow-x-scroll px-3">
  <% @events.each do |plan| %>
    <div class="level-item">
      <div class="card" style="max-width: 128px">
        <div class="card-image">
          <figure class="image">
            <%= image_tag plan.event.logo, loading: 'lazy' %>
          </figure>
        </div>
        <div class="card-content">
          <span class="size-7"><%= plan.event.name %></span>
        </div>
      </div>
    </div>
  <% end %>
  </div>
</div>
