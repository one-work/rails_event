<div data-controller="seats" class="mt-3">
  <%= form_with url: { controller: 'eventual/my/plan_joins', action: 'create', plan_id: @plan.id }, id: 'seat_form', data: { seats_target: 'form' } do %><% end %>
  <div class="fixed-grid overflow-x-auto">
  <% @plan.hall.rows.to_i.times do |row| %>
    <div id="row_<%= row %>" class="grid" style="--bulma-grid-column-count: <%= @plan.hall.cols + 1 %>">
      <div class="cell text-grey"><%= row + 1 %></div>
      <% @plan.hall.cols.to_i.times do |col| %>
        <% seat = @plan.sorted_seats.dig((row + 1).to_s, (col + 1).to_s) %>
        <% if seat %>
          <div data-controller="input" data-col="<%= col %>" data-seat-no="<%= seat['seatNo'] %>" class="cell">
            <%=
              check_box_tag(
                'plan_join[][seat_no]',
                seat['seatNo'],
                data: { action: 'seats#choose input#submit' },
                class: 'checkbox xl outline-danger',
                id: seat['seatNo'],
                form: 'seat_form'
              )
            %>
          </div>
        <% else %>
          <div data-col="<%= col %>" class="cell">
            <%= check_box_tag '', disabled: true, class: 'checkbox xl', id: nil %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
  </div>
  <div id="seats_choosed" class="flex">

  </div>
</div>
