<div data-controller="seats">
  <%= form_with url: { controller: 'eventual/my/plan_joins', action: 'create', plan_id: @plan.id }, id: 'seat_form', data: { seats_target: 'form' } do %><% end %>
  <div class="fixed-grid has-<%= @plan.hall.cols + 1 %>-cols">
  <% @plan.hall.rows.times do |row| %>
    <div class="grid" id="row_<%= row %>">
      <div class="cell text-grey"><%= row + 1 %></div>
      <% @plan.hall.cols.times do |col| %>
        <% seat = @plan.sorted_seats.dig((row + 1).to_s, col) %>
        <% if seat %>
          <div data-controller="input" data-seat-no="<%= seat['seatNo'] %>" class="cell">
            <%= check_box_tag 'plan_join[][seat_no]', seat['seatNo'], data: { action: 'seats#choose input#submit' }, class: 'checkbox xl', id: nil, form: 'seat_form' %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
  </div>
  <div id="seats_choosed">

  </div>
</div>
