<%= render 'filter_dropdown_areas' %>

<div class="fixed-grid has-4-cols">
  <div class="grid">
  <% @plan_ons.each do |plan| %>
    <div class="cell">
      <%= link_to plan.plan_on.to_fs(:month_and_day), { plan_on: plan.plan_on.to_fs(:date) } %>
    </div>
  <% end %>
  </div>
</div>

<%= render layout: 'index_list' do %>
  <% @plans.group_by(&:place).each do |place, plans| %>
    <%= render partial: 'index_item', layout: 'index_item_actions', locals: { place: place, plans: plans } %>
  <% end %>
<% end %>
