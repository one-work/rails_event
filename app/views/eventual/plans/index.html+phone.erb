<%= render 'filter_dropdown_areas' %>

<div class="level">
  <div class="level-left flex-direction-row overflow-x-scroll px-3">
  <% @plan_ons.each do |plan| %>
    <div class="level-item">
      <%= link_to({ plan_on: plan.plan_on.to_fs(:date) }, class: 'text-grey') do %>
        <span>今天</span>
        <span><%= plan.plan_on.to_fs(:month_and_day) %></span>
        <span class="text-grey-lighter">|</span>
      <% end %>
    </div>
  <% end %>
  </div>
</div>

<%= render layout: 'index_list' do %>
  <% @plans.group_by(&:place).each do |place, plans| %>
    <%= render partial: 'index_item', layout: 'index_item_actions', locals: { place: place, plans: plans } %>
  <% end %>
<% end %>
