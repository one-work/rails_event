<div class="p-3">
  <p><strong><%= @plan.event.name %></strong></p>
  <p>
    <span><%= extra_distance_date(@plan.plan_on) %></span>
    <time data-controller="time" data-format="T"><%= @plan.plan_at.to_fs(:iso8601) %></time>
  </p>
</div>
<div class="buttons as-bottom">
  <%= submit_tag '选座购票', disabled: true, id: 'order_form_submit', form: 'order_form', class: 'button is-primary is-medium' %>
</div>
