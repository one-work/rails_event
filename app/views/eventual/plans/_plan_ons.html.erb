<div class="level">
  <div class="level-left flex-direction-row overflow-x-scroll px-3">
  <% @plan_ons.each do |plan| %>
    <div class="level-item">
      <%= link_to({ plan_on: plan.plan_on.to_fs(:date) }, class: plan.plan_on.to_fs(:date) == (params[:plan_on] || Date.today.to_fs(:date)) ? 'text-link' : 'text-grey') do %>
        <span><%= distance_date(plan.plan_on) %></span>
        <span><%= plan.plan_on.to_fs(:month_and_day) %></span>
        <span class="text-grey-lighter">|</span>
      <% end %>
    </div>
  <% end %>
  </div>
</div>
